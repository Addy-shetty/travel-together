{
  "expo": {
    "name": "Travel-Together",
    "slug": "travel-together",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.traveltogether"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B5D6B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.traveltogether",
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Travel-Together uses the camera only to scan UPI QR codes when you tap Scan & Pay. Images never leave your phone.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing"
    ],
    "scheme": "traveltogether",
    "experiments": {
      "typedRoutes": true
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
